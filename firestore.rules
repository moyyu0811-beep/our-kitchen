rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Auth user profile — only readable/writable by the owner
    match /auth_users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Household registry — publicly readable so join-code validation works before sign-in
    match /households/{householdId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Helper: get the caller's households array from their auth_users doc
    // Note: only called for data collections, never for auth_users itself
    function getMyHouseholds() {
      return get(/databases/$(database)/documents/auth_users/$(request.auth.uid)).data.get('households', []);
    }

    function isMemberOf(hid) {
      return request.auth != null && hid in getMyHouseholds();
    }

    // All data collections: read/write only if authenticated and householdId matches
    match /menu/{docId} {
      allow read, write: if isMemberOf(resource.data.householdId);
      allow create: if isMemberOf(request.resource.data.householdId);
    }

    match /users/{docId} {
      allow read, write: if isMemberOf(resource.data.householdId);
      allow create: if isMemberOf(request.resource.data.householdId);
    }

    match /calendar/{docId} {
      allow read, write: if isMemberOf(resource.data.householdId);
      allow create: if isMemberOf(request.resource.data.householdId);
    }

    match /grocery_list/{docId} {
      allow read, write: if isMemberOf(resource.data.householdId);
      allow create: if isMemberOf(request.resource.data.householdId);
    }

    match /inventory/{docId} {
      allow read, write: if isMemberOf(resource.data.householdId);
      allow create: if isMemberOf(request.resource.data.householdId);
    }

    match /purchase_history/{docId} {
      allow read, write: if isMemberOf(resource.data.householdId);
      allow create: if isMemberOf(request.resource.data.householdId);
    }
  }
}