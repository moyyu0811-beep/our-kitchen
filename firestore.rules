rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Auth user profile — only readable/writable by the owner
    match /auth_users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Household registry — any authenticated user can read/write (needed for create/join)
    match /households/{householdId} {
      allow read, write: if request.auth != null;
    }

    // Helper: get the caller's householdId from their auth_users doc
    function getMyHouseholdId() {
      return get(/databases/$(database)/documents/auth_users/$(request.auth.uid)).data.householdId;
    }

    // All data collections: read/write only if authenticated and householdId matches
    match /menu/{docId} {
      allow read, write: if request.auth != null
        && resource.data.householdId == getMyHouseholdId();
      allow create: if request.auth != null
        && request.resource.data.householdId == getMyHouseholdId();
    }

    match /users/{docId} {
      allow read, write: if request.auth != null
        && resource.data.householdId == getMyHouseholdId();
      allow create: if request.auth != null
        && request.resource.data.householdId == getMyHouseholdId();
    }

    match /calendar/{docId} {
      allow read, write: if request.auth != null
        && resource.data.householdId == getMyHouseholdId();
      allow create: if request.auth != null
        && request.resource.data.householdId == getMyHouseholdId();
    }

    match /grocery_list/{docId} {
      allow read, write: if request.auth != null
        && resource.data.householdId == getMyHouseholdId();
      allow create: if request.auth != null
        && request.resource.data.householdId == getMyHouseholdId();
    }

    match /inventory/{docId} {
      allow read, write: if request.auth != null
        && resource.data.householdId == getMyHouseholdId();
      allow create: if request.auth != null
        && request.resource.data.householdId == getMyHouseholdId();
    }

    match /purchase_history/{docId} {
      allow read, write: if request.auth != null
        && resource.data.householdId == getMyHouseholdId();
      allow create: if request.auth != null
        && request.resource.data.householdId == getMyHouseholdId();
    }
  }
}